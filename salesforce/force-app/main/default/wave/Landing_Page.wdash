    },
    "support_table_heading": {
      "parameters": {
        "content": {
          "richTextContent": [
            {
              "attributes": {
                "color": "#0F172A",
                "size": "15px",
                "bold": true
              },
              "insert": "Segment Comparison"
            },
            {
              "attributes": {
                "align": "left"
              },
              "insert": "\n"
            },
            {
              "attributes": {
                "color": "#64748B",
                "size": "12px",
                "bold": false
              },
              "insert": "Concise portfolio-level health, churn, support-volume, escalation, and resolution measures."
            },
            {
              "attributes": {
                "align": "left"
              },
              "insert": "\n"
            }
          ]
        },
        "interactions": [],
        "showActionMenu": false
      },
      "type": "text"
    },
    "guide_finance": {
      "parameters": {
        "content": {
          "richTextContent": [
            {
              "attributes": {
                "color": "#0F172A",
                "size": "15px",
                "bold": true
              },
              "insert": "ARR and MRR"
            },
            {
              "attributes": {
                "align": "left"
              },
              "insert": "\n"
            },
            {
              "attributes": {
                "color": "#64748B",
                "size": "12px",
                "bold": false
              },
              "insert": "Current ARR = current monthly recurring revenue x 12. At-risk ARR applies the same annualization only to Critical and At Risk accounts. Churned accounts have zero current MRR."
            },
            {
              "attributes": {
                "align": "left"
              },
              "insert": "\n"
            }
          ]
        },
        "interactions": [],
        "showActionMenu": false
      },
      "type": "text"
    },
    "guide_health": {
      "parameters": {
        "content": {
          "richTextContent": [
            {
              "attributes": {
                "color": "#0F172A",
                "size": "15px",
                "bold": true
              },
              "insert": "Health Score and Risk Band"
            },
            {
              "attributes": {
                "align": "left"
              },
              "insert": "\n"
            },
            {
              "attributes": {
                "color": "#64748B",
                "size": "12px",
                "bold": false
              },
              "insert": "Health Score combines product usage, payment health, support experience, and customer-success engagement. Risk bands translate that score into Healthy, Watch, At Risk, and Critical."
            },
            {
              "attributes": {
                "align": "left"
              },
              "insert": "\n"
            }
          ]
        },
        "interactions": [],
        "showActionMenu": false
      },
      "type": "text"
    },
    "guide_retention": {
      "parameters": {
        "content": {
          "richTextContent": [
            {
              "attributes": {
                "color": "#0F172A",
                "size": "15px",
                "bold": true
              },
              "insert": "Retention Cohorts"
            },
            {
              "attributes": {
                "align": "left"
              },
              "insert": "\n"
            },
            {
              "attributes": {
                "color": "#64748B",
                "size": "12px",
                "bold": false
              },
              "insert": "Rows group customers by acquisition month. Retention Rate is the share still retained at each month since acquisition. Small cohort sizes make this sample directional."
            },
            {
              "attributes": {
                "align": "left"
              },
              "insert": "\n"
            }
          ]
        },
        "interactions": [],
        "showActionMenu": false
      },
      "type": "text"
    },
    "guide_ltv": {
      "parameters": {
        "content": {
          "richTextContent": [
            {
              "attributes": {
                "color": "#0F172A",
                "size": "15px",
                "bold": true
              },
              "insert": "Estimated Lifetime Value"
            },
            {
              "attributes": {
                "align": "left"
              },
              "insert": "\n"
            },
            {
              "attributes": {
                "color": "#64748B",
                "size": "12px",
                "bold": false
              },
              "insert": "Portfolio LTV uses average MRR x 75% gross margin divided by the assumed monthly churn rate. It is a modeling demonstration, not a finance forecast."
            },
            {
              "attributes": {
                "align": "left"
              },
              "insert": "\n"
            }
          ]
        },
        "interactions": [],
        "showActionMenu": false
      },
      "type": "text"
    },
    "guide_pipeline": {
      "parameters": {
        "content": {
          "richTextContent": [
            {
              "attributes": {
                "color": "#0F172A",
                "size": "15px",
                "bold": true
              },
              "insert": "Expansion Pipeline"
            },
            {
              "attributes": {
                "align": "left"
              },
              "insert": "\n"
            },
            {
              "attributes": {
                "color": "#64748B",
                "size": "12px",
                "bold": false
              },
              "insert": "Open Pipeline is total potential opportunity value. Weighted Pipeline multiplies value by probability. Expansion Readiness combines health and opportunity value."
            },
            {
              "attributes": {
                "align": "left"
              },
              "insert": "\n"
            }
          ]
        },
        "interactions": [],
        "showActionMenu": false
      },
      "type": "text"
    },
    "guide_support": {
      "parameters": {
        "content": {
          "richTextContent": [
            {
              "attributes": {
                "color": "#0F172A",
                "size": "15px",
                "bold": true
              },
              "insert": "Support Impact"
            },
            {
              "attributes": {
                "align": "left"
              },
              "insert": "\n"
            },
            {
              "attributes": {
                "color": "#64748B",
                "size": "12px",
                "bold": false
              },
              "insert": "Support measures include volume, escalations, resolution rate, health, and churn. The current sample has zero call volume, so interpretation must remain descriptive."
