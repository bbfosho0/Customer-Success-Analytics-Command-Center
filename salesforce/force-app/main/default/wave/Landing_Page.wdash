  "widgetStyle": {
    "backgroundColor": "#FFFFFF",
    "borderColor": "#E2E8F0",
    "borderEdges": [
      "all"
    ],
    "borderRadius": 8,
    "borderWidth": 1,
    "tooltipStyle": {
      "backgroundColor": "#0F172A",
      "labelColor": "#CBD5E1",
      "valueColor": "#FFFFFF"
    }
  },
  "widgets": {
    "risk_header_container": {
      "parameters": {
        "alignmentX": "left",
        "alignmentY": "top",
        "fit": "original",
        "interactions": []
      },
      "type": "container"
    },
    "risk_title": {
      "parameters": {
        "content": {
          "richTextContent": [
            {
              "attributes": {
                "color": "#FFFFFF",
                "size": "24px",
                "bold": true
              },
              "insert": "Health & Risk"
            },
            {
              "attributes": {
                "align": "left"
              },
              "insert": "\n"
            },
            {
              "attributes": {
                "color": "#CBD5E1",
                "size": "12px",
                "bold": false
              },
              "insert": "Prioritize accounts by current recurring revenue exposure, severity, and ownership."
            },
            {
              "attributes": {
                "align": "left"
              },
              "insert": "\n"
            },
            {
              "attributes": {
                "color": "#94A3B8",
                "size": "12px",
                "bold": false
              },
              "insert": "Illustrative 2025 portfolio snapshot"
            },
            {
              "attributes": {
                "align": "left"
              },
              "insert": "\n"
            }
          ]
        },
        "interactions": [],
        "showActionMenu": false
      },
      "type": "text"
    },
