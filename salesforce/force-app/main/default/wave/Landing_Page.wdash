rs":{"columnProperties":{},"columns":[],"customBulkActions":[],"headerProperties":{},"interactions":[],"maxColumnWidth":300,"minColumnWidth":60,"mode":"variable","totals":false},"type":"table"}},"support_churn":{"broadcastFacet":false,"datasets":[{"name":"Support_Impact_On_Churn"}],"isGlobal":false,"query":{"query":"{\"measures\":[[\"avg\",\"Churn_Rate__c\"],[\"avg\",\"Avg_Support_Calls__c\"],[\"avg\",\"Avg_Escalated_Calls__c\"]],\"groups\":[\"Segment__c\"],\"order\":[[\"avg_Churn_Rate__c\",{\"ascending\":false}]]}","version":-1.0},"receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"multi","type":"aggregateflex","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"options":{},"visualizationType":"vbar"}},"retention_heatmap":{"broadcastFacet":false,"datasets":[{"name":"Retention_Cohorts"}],"isGlobal":false,"query":{"query":"{\"measures\":[[\"avg\",\"Retention_Rate__c\"]],\"groups\":[\"Cohort_Month__c\",\"Month_Number__c\"],\"order\":[[\"Cohort_Month__c\",{\"ascending\":true}],[\"Month_Number__c\",{\"ascending\":true}]]}","version":-1.0},"receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"multi","type":"aggregateflex","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"options":{},"visualizationType":"matrix"}}},"widgetStyle":{"backgroundColor":"#FFFFFF","borderColor":"#D9DEE7","borderEdges":["all"],"borderRadius":8,"borderWidth":1,"tooltipStyle":{"backgroundColor":"#0A1733","labelColor":"#C9D4E5","valueColor":"#FFFFFF"}},"widgets":{"overview_kpi_arr_help":{"parameters":{"content":{"richTextContent":[{"attributes":{"color":"#5E6C84","size":"11px","bold":false},"insert":"The recurring revenue represented by the current monthly run rate over one year."},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":false},"type":"text"},"retention_reset":{"parameters":{"destinationLink":{"name":"Landing_Page","namespace":""},"destinationType":"dashboard","fontSize":12,"includeState":false,"text":"Reset filters","textAlignment":"center","textColor":"#14274E"},"type":"link"},"exp_selector_plan":{"parameters":{"compact":true,"displayMode":"combo","exploreLink":false,"filterStyle":{"titleColor":"#5E6C84","valueColor":"#172B4D"},"instant":true,"interactions":[],"measureField":"count","showActionMenu":false,"step":"expansion_filter_plan","title":"Plan Tier"},"type":"listselector"},"overview_risk_action":{"parameters":{"destinationLink":{"name":"At_Risk_Account_Dashboard","namespace":""},"destinationType":"dashboard","fontSize":13,"includeState":false,"text":"Open At-Risk Account Dashboard","textAlignment":"right","textColor":"#2E5BFF"},"type":"link"},"support_note":{"parameters":{"content":{"richTextContent":[{"attributes":{"color":"#7A3E00","size":"13px","bold":false},"insert":"Correlation, not causation: these comparisons can reveal patterns, but they do not prove that support activity causes churn."},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":false},"type":"text"},"overview_table_risk":{"parameters":{"borderColor":"#D9DEE7","borderWidth":1,"cell":{"backgroundColor":"#FFFFFF","fontColor":"#172B4D","fontSize":12},"columnProperties":{},"columns":[],"customBulkActions":[],"exploreLink":true,"header":{"backgroundColor":"#EEF1F6","fontColor":"#0A1733","fontSize":12},"headerProperties":{},"innerMajorBorderColor":"#D9DEE7","innerMinorBorderColor":"#EEF1F6","interactions":[],"maxColumnWidth":280,"minColumnWidth":70,"mode":"variable","numberOfLines":2,"pivoted":false,"showActionMenu":true,"showRowIndexColumn":false,"step":"overview_top_risk","totals":false,"verticalPadding":9},"type":"table"},"exp_chart_timeline":{"parameters":{"autoFitMode":"fit","totalValue":"computeTotal","legend":{"descOrder":false,"showHeader":false,"show":false,"customSize":"auto","position":"right-top","inside":false},"axisMode":"multi","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]}}},"visualizationType":"vbar","exploreLink":true,"title":{"fontSize":15,"subtitleFontSize":11,"label":"Weighted Pipeline by Expected Close Date","align":"left","subtitleLabel":"Places probability-adjusted expansion value on the expected closing timeline."},"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"totalLabel":"","columnMap":{"split":[],"trellis":[],"dimension":["Next_Close_Date__c"],"dimensionAxis":["Next_Close_Date__c"],"plots":["sum_Weighted_Pipeline_Amount__c"]},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":false,"showAxis":false,"title":"","customDomain":{"showDomain":false}},"valueType":"compactNumber","measureAxis1":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"Weighted Expansion Pipeline","customDomain":{"showDomain":false}},"step":"exp_timeline","theme":"wave","applyConditionalFormatting":false,"dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"Expected Close Date"}},"type":"chart"},"guide_primary_risk_driver":{"parameters":{"content":{"richTextContent":[{"attributes":{"color":"#172B4D","size":"12px","bold":false},"insert":"Primary Risk Driver\nThe leading issue associated with a customer's current risk status.\nFormula: Dataset-provided account assessment\nWhy it matters: It turns a risk signal into a more specific intervention starting point.\nHow to read it: Use the driver to group accounts and select the right follow-up action.\nCaveat: A customer can have more than one contributing issue."},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":false},"type":"text"},"overview_kpi_health_help":{"parameters":{"content":{"richTextContent":[{"attributes":{"color":"#5E6C84","size":"11px","bold":false},"insert":"A composite dataset-provided indicator of customer health; higher scores mean healthier customers."},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":false},"type":"text"},"guide_health_score":{"parameters":{"content":{"richTextContent":[{"attributes":{"color":"#172B4D","size":"12px","bold":false},"insert":"Health Score\nA composite dataset-provided indicator of customer health; higher scores mean healthier customers.\nFormula: Provided by the demonstration dataset\nWhy it matters: It helps customer-success teams identify accounts that may need attention before renewal or expansion.\nHow to read it: Read the score with risk band, revenue, support activity, and the primary risk driver.\nCaveat: No undocumented scoring formula is assumed or presented in this dashboard."},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":false},"type":"text"},"guide_expansion_readiness":{"parameters":{"content":{"richTextContent":[{"attributes":{"color":"#172B4D","size":"12px","bold":false},"insert":"Expansion Readiness\nAn indication of how prepared a customer appears for a larger commercial relationship.\nFormula: Dataset-provided classification\nWhy it matters: It helps focus growth conversations on customers with credible fit and timing.\nHow to read it: Readiness should be considered with health, relationship context, and expected close date.\nCaveat: Readiness is not a guarantee that an opportunity will close."},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":false},"type":"text"},"overview_kpi_customers_number":{"parameters":{"compact":true,"exploreLink":true,"interactions":[],"measureField":"count","numberColor":"#0A1733","numberSize":28,"showActionMenu":true,"step":"kpi_customers","textAlignment":"left","title":"Customers","titleColor":"#5E6C84","titleSize":12,"tooltip":{"customizeTooltip":false}},"type":"number"},"guide_risk_band":{"parameters":{"content":{"richTextContent":[{"attributes":{"color":"#172B4D","size":"12px","bold":false},"insert":"Risk Band\nA plain-language category that groups customers by urgency: Critical, At Risk, Watch, or Healthy.\nFormula: Dataset-provided classification\nWhy it matters: It lets leaders quickly see where intervention capacity should be focused.\nHow to read it: Critical requires the fastest response; Healthy indicates no immediate risk signal.\nCaveat: A category is a decision aid and should not replace account-specific judgment."},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":false},"type":"text"},"guide_plan_tier":{"parameters":{"content":{"richTextContent":[{"attributes":{"color":"#172B4D","size":"12px","bold":false},"insert":"Plan Tier\nThe customer's subscription or service package.\nFormula: Dataset-provided subscription classification\nWhy it matters: It helps compare health, support, retention, and expansion across offerings.\nHow to read it: Differences may indicate product fit, service expectations, or customer mix.\nCaveat: Plan tier should be interpreted with segment and customer context."},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":false},"type":"text"},"guide_at_risk_arr":{"parameters":{"content":{"richTextContent":[{"attributes":{"color":"#172B4D","size":"12px","bold":false},"insert":"At-Risk ARR\nAnnualized recurring revenue attached to customers currently classified as Critical or At Risk.\nFormula: Sum of MRR for Critical and At Risk accounts x 12\nWhy it matters: It connects customer health to the amount of recurring revenue that may be vulnerable.\nHow to read it: A rising value means more revenue is associated with accounts requiring intervention.\nCaveat: This is a prioritization signal, not a forecast that all exposed revenue will churn."},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":false},"type":"text"},"overview_kpi_arr_number":{"parameters":{"compact":true,"exploreLink":true,"interactions":[],"measureField":"B","numberColor":"#0A1733","numberSize":28,"showActionMenu":true,"step":"kpi_total_arr","textAlignment":"left","title":"Total ARR","titleColor":"#5E6C84","titleSize":12,"tooltip":{"customizeTooltip":false}},"type":"number"},"overview_kpi_expansion_number":{"parameters":{"compact":true,"exploreLink":true,"interactions":[],"measureField":"sum_Open_Pipeline_Amount__c","numberColor":"#0A1733","numberSize":28,"showActionMenu":true,"step":"kpi_open_expansion","textAlignment":"left","title":"Open Expansion Pipeline","titleColor":"#5E6C84","titleSize":12,"tooltip":{"customizeTooltip":false}},"type":"number"},"guide_subtitle":{"parameters":{"content":{"richTextContent":[{"attributes":{"color":"#DCE6F5","size":"13px","bold":false},"insert":"Plain-language definitions, formulas, interpretation guidance, and limitations for every business term in this command center"},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":false},"type":"text"},"exp_action":{"parameters":{"destinationLink":{"name":"Expansion_Pipeline_Dashboard","namespace":""},"destinationType":"dashboard","fontSize":13,"includeState":false,"text":"Open Expansion Pipeline Dashboard","textAlignment":"right","textColor":"#2E5BFF"},"type":"link"},"guide_cohort_size":{"parameters":{"content":{"richTextContent":[{"attributes":{"color":"#172B4D","size":"12px","bold":false},"insert":"Cohort Size\nThe number of customers in a cohort when it began.\nFormula: Starting customers in the acquisition cohort\nWhy it matters: It helps distinguish a broad pattern from movement in a very small group.\nHow to read it: Give more weight to patterns supported by larger cohorts.\nCaveat: Size does not indicate the revenue value of the cohort."},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":false},"type":"text"},"retention_chart_heatmap":{"parameters":{"autoFitMode":"fit","totalValue":"computeTotal","legend":{"descOrder":false,"showHeader":false,"show":true,"customSize":"auto","position":"right-top","inside":false},"highColor":"#008C8C","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]}}},"lowColor":"#E7F6F4","visualizationType":"matrix","exploreLink":true,"title":{"fontSize":15,"subtitleFontSize":11,"label":"Cohort Retention Heatmap","align":"left","subtitleLabel":"Each row is a starting cohort; color shows the share retained in each later month."},"totalLabel":"","columnMap":{"r":["avg_Retention_Rate__c"],"split":[],"color":["avg_Retention_Rate__c"],"x":["Month_Number__c"],"y":["Cohort_Month__c"],"trellis":[],"dimensionAxis":[],"plots":["avg_Retention_Rate__c"]},"showActionMenu":true,"valueType":"percent","x":{"showTitle":true,"showAxis":true,"title":"Month Since Acquisition"},"y":{"showTitle":true,"showAxis":true,"title":"Customer Cohort"},"step":"retention_heatmap","theme":"wave","applyConditionalFormatting":false},"type":"chart"},"guide_churn_rate":{"parameters":{"content":{"richTextContent":[{"attributes":{"color":"#172B4D","size":"12px","bold":false},"insert":"Churn Rate\nThe share of customers that stopped being retained during the measured period.\nFormula: Churned customers divided by the starting customer population\nWhy it matters: Churn directly affects recurring revenue durability and growth efficiency.\nHow to read it: Lower is generally better; compare like-for-like periods and populations.\nCaveat: The exact period and denominator must remain consistent."},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":false},"type":"text"},"retention_action":{"parameters":{"destinationLink":{"name":"Retention_Cohort_Dashboard","namespace":""},"destinationType":"dashboard","fontSize":13,"includeState":false,"text":"Open Retention Cohort Dashboard","textAlignment":"right","textColor":"#2E5BFF"},"type":"link"},"guide_customer_success_manager":{"parameters":{"content":{"richTextContent":[{"attributes":{"color":"#172B4D","size":"12px","bold":false},"insert":"Customer Success Manager (CSM)\nThe person responsible for guiding the customer relationship and coordinating success actions.\nFormula: Assigned account owner in the customer-success process\nWhy it matters: Filtering by CSM makes ownership and workload visible.\nHow to read it: Use the filter to focus on one manager's portfolio and action queue.\nCaveat: The CSM may collaborate with support, sales, product, and leadership."},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":false},"type":"text"},"risk_title":{"parameters":{"content":{"richTextContent":[{"attributes":{"color":"#FFFFFF","size":"22px","bold":true},"insert":"Health & Risk"},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":false},"type":"text"},"risk_subtitle":{"parameters":{"content":{"richTextContent":[{"attributes":{"color":"#DCE6F5","size":"13px","bold":false},"insert":"Prioritize intervention using customer health, recurring revenue exposure, and the leading risk signal"},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":false},"type":"text"},"guide_annual_recurring_revenue":{"parameters":{"content":{"richTextContent":[{"attributes":{"color":"#172B4D","size":"12px","bold":false},"insert":"Annual Recurring Revenue (ARR)\nThe recurring revenue represented by the current monthly run rate over one year.\nFormula: Monthly Recurring Revenue x 12\nWhy it matters: ARR shows the recurring revenue base the company is working to retain and expand.\nHow to read it: Higher ARR means a larger recurring revenue base. Changes should be read alongside retention, churn, and expansion.\nCaveat: ARR is an annualized run-rate measure, not recognized accounting revenue."},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":false},"type":"text"},"overview_selector_segment":{"parameters":{"compact":true,"displayMode":"combo","exploreLink":false,"filterStyle":{"titleColor":"#5E6C84","valueColor":"#172B4D"},"instant":true,"interactions":[],"measureField":"count","showActionMenu":false,"step":"portfolio_filter_segment","title":"Customer Segment"},"type":"listselector"},"risk_chart_scatter":{"parameters":{"autoFitMode":"fit","totalValue":"computeTotal","legend":{"descOrder":false,"showHeader":false,"show":true,"customSize":"auto","position":"right-top","inside":false},"tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]}}},"visualizationType":"scatter","exploreLink":true,"title":{"fontSize":15,"subtitleFontSize":11,"label":"Customer Health versus Monthly Recurring Revenue","align":"left","subtitleLabel":"Highlights high-value customers with weaker health scores for faster prioritization."},"totalLabel":"","columnMap":{"split":[],"color":["Risk_Band__c"],"x":["avg_Health_Score__c"],"y":["sum_MRR__c"],"trellis":[],"dimension":["Account_Name__c"],"dimensionAxis":["Account_Name__c"],"plots":["avg_Health_Score__c","sum_MRR__c"]},"showActionMenu":true,"valueType":"compactNumber","x":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"Health Score","customDomain":{"showDomain":false}},"y":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"Monthly Recurring Revenue","customDomain":{"showDomain":false}},"step":"risk_scatter","theme":"wave","applyConditionalFormatting":false},"type":"chart"},"guide_weighted_pipeline":{"parameters":{"content":{"richTextContent":[{"attributes":{"color":"#172B4D","size":"12px","bold":false},"insert":"Weighted Expansion Pipeline\nThe probability-adjusted value of open expansion opportunities.\nFormula: Sum of dataset-provided weighted opportunity amounts\nWhy it matters: It provides a more conservative view of potential expansion than open pipeline.\nHow to read it: A large gap between open and weighted pipeline indicates lower confidence or earlier-stage opportunities.\nCaveat: The quality of this measure depends on the source weighting assumptions."},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":false},"type":"text"},"risk_table_queue":{"parameters":{"borderColor":"#D9DEE7","borderWidth":1,"cell":{"backgroundColor":"#FFFFFF","fontColor":"#172B4D","fontSize":12},"columnProperties":{},"columns":[],"customBulkActions":[],"exploreLink":true,"header":{"backgroundColor":"#EEF1F6","fontColor":"#0A1733","fontSize":12},"headerProperties":{},"innerMajorBorderColor":"#D9DEE7","innerMinorBorderColor":"#EEF1F6","interactions":[],"maxColumnWidth":280,"minColumnWidth":70,"mode":"variable","numberOfLines":2,"pivoted":false,"showActionMenu":true,"showRowIndexColumn":false,"step":"risk_queue","totals":false,"verticalPadding":9},"type":"table"},"guide_open_pipeline":{"parameters":{"content":{"richTextContent":[{"attributes":{"color":"#172B4D","size":"12px","bold":false},"insert":"Open Expansion Pipeline\nThe total potential value of expansion opportunities that are still open.\nFormula: Sum of open expansion opportunity amounts\nWhy it matters: It shows the maximum current expansion opportunity under consideration.\nHow to read it: Compare it with Weighted Pipeline to understand confidence and maturity.\nCaveat: Open pipeline is not committed revenue."},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":false},"type":"text"},"exp_help_weighted":{"parameters":{"content":{"richTextContent":[{"attributes":{"color":"#5E6C84","size":"11px","bold":false},"insert":"The probability-adjusted value of open expansion opportunities."},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":false},"type":"text"},"guide_retention_rate":{"parameters":{"content":{"richTextContent":[{"attributes":{"color":"#172B4D","size":"12px","bold":false},"insert":"Retention Rate\nThe share of a starting customer cohort that remains at a later point in time.\nFormula: Retained customers divided by starting cohort size\nWhy it matters: Retention is a core indicator of durable customer value and recurring revenue quality.\nHow to read it: Higher and more stable curves indicate stronger customer durability.\nCaveat: Small cohorts can produce volatile percentages."},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":false},"type":"text"},"guide_monthly_recurring_revenue":{"parameters":{"content":{"richTextContent":[{"attributes":{"color":"#172B4D","size":"12px","bold":false},"insert":"Monthly Recurring Revenue (MRR)\nThe recurring subscription revenue represented by one month of the current customer relationship.\nFormula: Recurring monthly subscription amount\nWhy it matters: MRR is the monthly building block used to calculate ARR and revenue exposure.\nHow to read it: Higher MRR accounts have more recurring revenue value and may warrant greater attention.\nCaveat: One-time fees and non-recurring services should not be interpreted as MRR."},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":false},"type":"text"},"support_chart_churn":{"parameters":{"autoFitMode":"fit","totalValue":"computeTotal","legend":{"descOrder":false,"showHeader":false,"show":true,"customSize":"auto","position":"right-top","inside":false},"axisMode":"multi","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]}}},"visualizationType":"vbar","exploreLink":true,"title":{"fontSize":15,"subtitleFontSize":11,"label":"Churn and Support Demand by Customer Segment","align":"left","subtitleLabel":"Compares customer loss with support volume and escalation patterns across segments."},"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"totalLabel":"","columnMap":{"split":[],"trellis":[],"dimension":["Segment__c"],"dimensionAxis":["Segment__c"],"plots":["avg_Churn_Rate__c","avg_Avg_Support_Calls__c","avg_Avg_Escalated_Calls__c"]},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":false,"showAxis":false,"title":"","customDomain":{"showDomain":false}},"valueType":"none","measureAxis1":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"Average Value","customDomain":{"showDomain":false}},"step":"support_churn","theme":"wave","applyConditionalFormatting":false,"dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"Customer Segment"}},"type":"chart"},"risk_chart_driver":{"parameters":{"autoFitMode":"fit","totalValue":"computeTotal","legend":{"descOrder":false,"showHeader":false,"show":false,"customSize":"auto","position":"right-top","inside":false},"axisMode":"multi","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]}}},"visualizationType":"hbar","exploreLink":true,"title":{"fontSize":15,"subtitleFontSize":11,"label":"Primary Risk Drivers","align":"left","subtitleLabel":"Shows which known issues are associated with the most recurring revenue exposure."},"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"totalLabel":"","columnMap":{"split":[],"trellis":[],"dimension":["Main_Risk_Driver__c"],"dimensionAxis":["Main_Risk_Driver__c"],"plots":["sum_MRR__c"]},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":false,"showAxis":false,"title":"","customDomain":{"showDomain":false}},"valueType":"compactNumber","measureAxis1":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"Monthly Recurring Revenue","customDomain":{"showDomain":false}},"step":"risk_driver","theme":"wave","applyConditionalFormatting":false,"dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"Primary Risk Driver"}},"type":"chart"},"retention_selector_cohort":{"parameters":{"compact":true,"displayMode":"combo","exploreLink":false,"filterStyle":{"titleColor":"#5E6C84","valueColor":"#172B4D"},"instant":true,"interactions":[],"measureField":"count","showActionMenu":false,"step":"retention_cohort_filter","title":"Customer Cohort"},"type":"listselector"},"exp_selector_close":{"parameters":{"compact":true,"displayMode":"combo","exploreLink":false,"filterStyle":{"titleColor":"#5E6C84","valueColor":"#172B4D"},"instant":true,"interactions":[],"measureField":"count","showActionMenu":false,"step":"expansion_filter_close","title":"Expected Close Date"},"type":"listselector"},"guide_cohort":{"parameters":{"content":{"richTextContent":[{"attributes":{"color":"#172B4D","size":"12px","bold":false},"insert":"Customer Cohort\nA group of customers that began during the same month.\nFormula: Customers grouped by acquisition month\nWhy it matters: It separates lifecycle effects from changes in customer acquisition mix.\nHow to read it: Compare rows to see whether newer cohorts retain better or worse than earlier cohorts.\nCaveat: Recent cohorts have fewer elapsed months available."},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":false},"type":"text"},"guide_escalations":{"parameters":{"content":{"richTextContent":[{"attributes":{"color":"#172B4D","size":"12px","bold":false},"insert":"Escalations\nSupport interactions that required a higher level of attention.\nFormula: Count or average of escalated support interactions\nWhy it matters: They can reveal severity, complexity, or customer-impact concentration.\nHow to read it: Rising escalations merit investigation, especially when health or retention also weakens.\nCaveat: Escalation practices can vary by team and customer tier."},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":false},"type":"text"},"guide_expected_close_date":{"parameters":{"content":{"richTextContent":[{"attributes":{"color":"#172B4D","size":"12px","bold":false},"insert":"Expected Close Date\nThe date an expansion opportunity is currently expected to close.\nFormula: Dataset-provided opportunity date\nWhy it matters: It supports planning, prioritization, and pipeline timing discussions.\nHow to read it: Use it to identify near-term opportunities and timing concentration.\nCaveat: Close dates can move as opportunity conditions change."},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":false},"type":"text"},"guide_customer_count":{"parameters":{"content":{"richTextContent":[{"attributes":{"color":"#172B4D","size":"12px","bold":false},"insert":"Customer Count\nThe number of customer records represented by the current filters.\nFormula: Count of customer rows\nWhy it matters: It provides scale and context for percentages, averages, and revenue totals.\nHow to read it: Use it to understand how broadly a risk or opportunity signal is distributed.\nCaveat: The demonstration dataset assumes one account-grain row per customer."},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":false},"type":"text"},"guide_correlation":{"parameters":{"content":{"richTextContent":[{"attributes":{"color":"#172B4D","size":"12px","bold":false},"insert":"Correlation, Not Causation\nTwo measures can move together without one being proven to cause the other.\nFormula: Descriptive comparison only\nWhy it matters: This prevents leaders from treating an observed association as proof of cause.\nHow to read it: Use the analysis to identify questions and segments for deeper investigation.\nCaveat: Causal claims require stronger research design and controls."},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":false},"type":"text"},"guide_support_volume":{"parameters":{"content":{"richTextContent":[{"attributes":{"color":"#172B4D","size":"12px","bold":false},"insert":"Support Volume\nThe amount of customer support demand represented by calls or cases.\nFormula: Average or total support interactions, as labeled\nWhy it matters: High support demand can indicate complexity, adoption friction, or service needs.\nHow to read it: Compare volume with resolution, escalations, health, and customer mix.\nCaveat: More support activity can reflect either problems or healthy customer engagement."},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":false},"type":"text"},"overview_kpi_expansion_help":{"parameters":{"content":{"richTextContent":[{"attributes":{"color":"#5E6C84","size":"11px","bold":false},"insert":"The total potential value of expansion opportunities that are still open."},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":false},"type":"text"},"support_reset":{"parameters":{"destinationLink":{"name":"Landing_Page","namespace":""},"destinationType":"dashboard","fontSize":12,"includeState":false,"text":"Reset filters","textAlignment":"center","textColor":"#14274E"},"type":"link"},"support_table_detail":{"parameters":{"borderColor":"#D9DEE7","borderWidth":1,"cell":{"backgroundColor":"#FFFFFF","fontColor":"#172B4D","fontSize":12},"columnProperties":{},"columns":[],"customBulkActions":[],"exploreLink":true,"header":{"backgroundColor":"#EEF1F6","fontColor":"#0A1733","fontSize":12},"headerProperties":{},"innerMajorBorderColor":"#D9DEE7","innerMinorBorderColor":"#EEF1F6","interactions":[],"maxColumnWidth":280,"minColumnWidth":70,"mode":"variable","numberOfLines":2,"pivoted":false,"showActionMenu":true,"showRowIndexColumn":false,"step":"support_table","totals":false,"verticalPadding":9},"type":"table"},"guide_reset":{"parameters":{"destinationLink":{"name":"Landing_Page","namespace":""},"destinationType":"dashboard","fontSize":12,"includeState":false,"text":"Reset filters","textAlignment":"center","textColor":"#14274E"},"type":"link"},"guide_resolution_rate":{"parameters":{"content":{"richTextContent":[{"attributes":{"color":"#172B4D","size":"12px","bold":false},"insert":"Resolution Rate\nThe share of support issues successfully resolved.\nFormula: Resolved support issues divided by total relevant support issues\nWhy it matters: Resolution quality can affect customer confidence and ongoing health.\nHow to read it: Higher is generally better when issue complexity and time period are comparable.\nCaveat: Resolution rate does not measure speed or customer satisfaction by itself."},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":false},"type":"text"},"overview_kpi_customers_help":{"parameters":{"content":{"richTextContent":[{"attributes":{"color":"#5E6C84","size":"11px","bold":false},"insert":"The number of customer records represented by the current filters."},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":false},"type":"text"},"risk_action":{"parameters":{"destinationLink":{"name":"At_Risk_Account_Dashboard","namespace":""},"destinationType":"dashboard","fontSize":13,"includeState":false,"text":"Open Full At-Risk Account Dashboard","textAlignment":"right","textColor":"#2E5BFF"},"type":"link"},"overview_selector_region":{"parameters":{"compact":true,"displayMode":"combo","exploreLink":false,"filterStyle":{"titleColor":"#5E6C84","valueColor":"#172B4D"},"instant":true,"interactions":[],"measureField":"count","showActionMenu":false,"step":"portfolio_filter_region","title":"Region"},"type":"listselector"},"overview_kpi_risk_number":{"parameters":{"compact":true,"exploreLink":true,"interactions":[],"measureField":"B","numberColor":"#BA0517","numberSize":28,"showActionMenu":true,"step":"kpi_at_risk_arr","textAlignment":"left","title":"At-Risk ARR","titleColor":"#5E6C84","titleSize":12,"tooltip":{"customizeTooltip":false}},"type":"number"},"overview_kpi_risk_help":{"parameters":{"content":{"richTextContent":[{"attributes":{"color":"#5E6C84","size":"11px","bold":false},"insert":"Annualized recurring revenue attached to customers currently classified as Critical or At Risk."},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":false},"type":"text"},"support_title":{"parameters":{"content":{"richTextContent":[{"attributes":{"color":"#FFFFFF","size":"22px","bold":true},"insert":"Support Impact"},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":false},"type":"text"},"overview_reset":{"parameters":{"destinationLink":{"name":"Landing_Page","namespace":""},"destinationType":"dashboard","fontSize":12,"includeState":false,"text":"Reset filters","textAlignment":"center","textColor":"#14274E"},"type":"link"},"retention_subtitle":{"parameters":{"content":{"richTextContent":[{"attributes":{"color":"#DCE6F5","size":"13px","bold":false},"insert":"Compare customer cohorts from a common starting month and see how durability changes over time"},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":false},"type":"text"},"exp_number_open":{"parameters":{"compact":true,"exploreLink":true,"interactions":[],"measureField":"sum_Open_Pipeline_Amount__c","numberColor":"#0A1733","numberSize":28,"showActionMenu":true,"step":"exp_kpi_open","textAlignment":"left","title":"Open Expansion Pipeline","titleColor":"#5E6C84","titleSize":12,"tooltip":{"customizeTooltip":false}},"type":"number"},"risk_reset":{"parameters":{"destinationLink":{"name":"Landing_Page","namespace":""},"destinationType":"dashboard","fontSize":12,"includeState":false,"text":"Reset filters","textAlignment":"center","textColor":"#14274E"},"type":"link"},"guide_recommended_action":{"parameters":{"content":{"richTextContent":[{"attributes":{"color":"#172B4D","size":"12px","bold":false},"insert":"Recommended Action\nThe suggested next step for improving the customer outcome.\nFormula: Dataset-provided recommendation\nWhy it matters: It helps teams move from analysis to coordinated action.\nHow to read it: Treat it as a starting recommendation and confirm it with account context.\nCaveat: The assigned owner should validate the action before execution."},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":false},"type":"text"},"overview_chart_arr_risk":{"parameters":{"autoFitMode":"fit","totalValue":"computeTotal","legend":{"descOrder":false,"showHeader":false,"show":false,"customSize":"auto","position":"right-top","inside":false},"axisMode":"multi","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]}}},"visualizationType":"hbar","exploreLink":true,"title":{"fontSize":15,"subtitleFontSize":11,"label":"Recurring Revenue Exposure by Risk Band","align":"left","subtitleLabel":"Shows where monthly recurring revenue is concentrated across customer risk levels."},"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"totalLabel":"","columnMap":{"split":[],"trellis":[],"dimension":["Risk_Band__c"],"dimensionAxis":["Risk_Band__c"],"plots":["sum_MRR__c"]},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":false,"showAxis":false,"title":"","customDomain":{"showDomain":false}},"valueType":"compactNumber","measureAxis1":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"Monthly Recurring Revenue","customDomain":{"showDomain":false}},"step":"overview_arr_risk","theme":"wave","applyConditionalFormatting":false,"dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"Risk Band"}},"type":"chart"},"expansion_title":{"parameters":{"content":{"richTextContent":[{"attributes":{"color":"#FFFFFF","size":"22px","bold":true},"insert":"Expansion"},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":false},"type":"text"},"overview_title":{"parameters":{"content":{"richTextContent":[{"attributes":{"color":"#FFFFFF","size":"22px","bold":true},"insert":"Customer Success Command Center"},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":false},"type":"text"},"overview_selector_csm":{"parameters":{"compact":true,"displayMode":"combo","exploreLink":false,"filterStyle":{"titleColor":"#5E6C84","valueColor":"#172B4D"},"instant":true,"interactions":[],"measureField":"count","showActionMenu":false,"step":"portfolio_filter_csm","title":"Customer Success Manager"},"type":"listselector"},"overview_selector_plan":{"parameters":{"compact":true,"displayMode":"combo","exploreLink":false,"filterStyle":{"titleColor":"#5E6C84","valueColor":"#172B4D"},"instant":true,"interactions":[],"measureField":"count","showActionMenu":false,"step":"portfolio_filter_plan","title":"Plan Tier"},"type":"listselector"},"retention_chart_trend":{"parameters":{"autoFitMode":"fit","totalValue":"computeTotal","legend":{"descOrder":false,"showHeader":false,"show":false,"customSize":"auto","position":"right-top","inside":false},"axisMode":"multi","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]}}},"visualizationType":"line","exploreLink":true,"title":{"fontSize":15,"subtitleFontSize":11,"label":"Average Retention Curve","align":"left","subtitleLabel":"Summarizes the typical percentage of customers remaining as time passes."},"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"totalLabel":"","columnMap":{"split":[],"trellis":[],"dimension":["Month_Number__c"],"dimensionAxis":["Month_Number__c"],"plots":["avg_Retention_Rate__c"]},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":false,"showAxis":false,"title":"","customDomain":{"showDomain":false}},"valueType":"percent","measureAxis1":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"Retention Rate","customDomain":{"showDomain":false}},"step":"retention_trend","theme":"wave","applyConditionalFormatting":false,"dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"Month Since Acquisition"}},"type":"chart"},"guide_segment":{"parameters":{"content":{"richTextContent":[{"attributes":{"color":"#172B4D","size":"12px","bold":false},"insert":"Customer Segment\nA grouping of customers with similar commercial size or service needs.\nFormula: Dataset-provided customer classification\nWhy it matters: Different segments can have different risk, retention, and expansion patterns.\nHow to read it: Use segment comparisons to allocate coverage and identify structural differences.\nCaveat: Segment definitions are specific to the source dataset."},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":false},"type":"text"},"support_subtitle":{"parameters":{"content":{"richTextContent":[{"attributes":{"color":"#DCE6F5","size":"13px","bold":false},"insert":"Compare support demand, escalations, resolution, customer health, and churn without overstating causality"},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":false},"type":"text"},"expansion_subtitle":{"parameters":{"content":{"richTextContent":[{"attributes":{"color":"#DCE6F5","size":"13px","bold":false},"insert":"Focus growth effort on healthy customers with credible opportunity, timing, and commercial value"},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":false},"type":"text"},"risk_chart_summary":{"parameters":{"totalValue":"computeTotal","autoFitMode":"fit","legend":{"descOrder":false,"showHeader":false,"show":true,"customSize":"auto","position":"right-top","inside":false},"tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]}}},"visualizationType":"donut","exploreLink":true,"title":{"fontSize":15,"subtitleFontS