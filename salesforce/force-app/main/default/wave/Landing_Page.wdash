"Weighted_Pipeline_Amount__c\"]],\"groups\":[\"Next_Close_Date__c\"],\"order\":[[\"Next_Close_Date__c\",{\"ascending\":true}]]}","version":-1.0},"receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"multi","type":"aggregateflex","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"options":{},"visualizationType":"vbar"}},"kpi_total_arr":{"broadcastFacet":false,"datasets":[{"name":"Customer_360"}],"isGlobal":false,"query":{"query":"{\"measures\":[[\"sum\",\"MRR__c\",\"A\"]],\"columns\":[{\"query\":{\"measures\":[[\"sum\",\"MRR__c\"]]}},{\"query\":{\"measures\":[[\"sum\",\"MRR__c\"]],\"formula\":\"A * 12\"},\"header\":\"Total ARR\"}]}","version":-1.0},"receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"multi","type":"aggregateflex","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"options":{},"visualizationType":"hbar"}},"portfolio_filter_plan":{"broadcastFacet":true,"datasets":[{"name":"Customer_360"}],"isGlobal":false,"query":{"query":"{\"measures\":[[\"count\",\"*\"]],\"groups\":[\"Plan_Tier__c\"],\"order\":[[\"Plan_Tier__c\",{\"ascending\":true}]]}","version":-1.0},"receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"multi","type":"aggregateflex","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"options":{},"visualizationType":"hbar"}},"kpi_open_expansion":{"broadcastFacet":false,"datasets":[{"name":"Expansion_Opportunities"}],"isGlobal":false,"query":{"query":"{\"measures\":[[\"sum\",\"Open_Pipeline_Amount__c\"]],\"filters\":[]}","version":-1.0},"receiveFacetSource":{"mode":"all","steps":[]},"selectMode":"multi","type":"aggregateflex","useExternalFilters":true,"useGlobal":true,"visualizationParameters":{"options":{},"visualizationType":"hbar"}},"retention_trend":{"broadcastFacet":false,"datasets":[{"name":"Retention_Cohorts"}],"isGlobal":false,"query":{"query":"{\"measures\":[[\"avg\",\"Retention_Rate__c\"]],\"groups\":[\"Month_Number__c\"],\"order\":[[\"Month_Number__c\",{\"ascen