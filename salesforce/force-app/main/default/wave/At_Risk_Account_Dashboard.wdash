      "visualizationParameters": {
        "options": {},
        "visualizationType": "hbar"
      }
    },
    "risk_detail_arr": {
      "broadcastFacet": false,
      "groups": [],
      "numbers": [
        "At_Risk_ARR"
      ],
      "query": "q = load \"Churn_Risk_Accounts\"; q = filter q by 'Risk_Band__c' in [\"Critical\", \"At Risk\"]; q = group q by all; q = foreach q generate sum(q.'MRR__c') * 12 as 'At_Risk_ARR';",
      "receiveFacetSource": {
        "mode": "all",
        "steps": []
      },
      "selectMode": "single",
      "strings": [],
      "type": "saql",
      "useGlobal": true,
      "visualizationParameters": {
        "options": {},
        "visualizationType": "hbar"
      }
    },
    "risk_detail_band": {
      "broadcastFacet": false,
      "datasets": [
        {
          "name": "Churn_Risk_Accounts"
        }
      ],
      "isGlobal": false,
      "query": {
        "query": "{\"measures\":[[\"sum\",\"MRR__c\"]],\"groups\":[\"Risk_Band__c\"],\"filters\":[[\"Risk_Band__c\",[\"Critical\",\"At Risk\",\"Watch\"],\"in\"]],\"order\":[[\"sum_MRR__c\",{\"ascending\":false}]]}",
        "version": -1
      },
      "receiveFacetSource": {
        "mode": "all",
        "steps": []
      },
      "selectMode": "multi",
      "type": "aggregateflex",
      "useExternalFilters": true,
      "useGlobal": true,
      "visualizationParameters": {
        "options": {},
        "visualizationType": "hbar"
      }
    },
    "risk_detail_driver": {
      "broadcastFacet": false,
      "datasets": [
        {
          "name": "Churn_Risk_Accounts"
        }
      ],
      "isGlobal": false,
      "query": {
        "query": "{\"measures\":[[\"sum\",\"MRR__c\"]],\"groups\":[\"Main_Risk_Driver__c\"],\"filters\":[[\"Risk_Band__c\",[\"Critical\",\"At Risk\",\"Watch\"],\"in\"]],\"order\":[[\"sum_MRR__c\",{\"ascending\":false}]]}",
        "version": -1
