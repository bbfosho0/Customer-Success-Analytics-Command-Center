    "risk_detail_health": {
      "broadcastFacet": false,
      "datasets": [
        {
          "name": "Churn_Risk_Accounts"
        }
      ],
      "isGlobal": false,
      "query": {
        "query": "{\"measures\":[[\"avg\",\"Health_Score__c\"]],\"filters\":[[\"Risk_Band__c\",[\"Critical\",\"At Risk\",\"Watch\"],\"in\"]]}",
        "version": -1
      },
      "receiveFacetSource": {
        "mode": "all",
        "steps": []
      },
      "selectMode": "multi",
      "type": "aggregateflex",
      "useExternalFilters": true,
