      "datasets": [
        {
          "name": "Churn_Risk_Accounts"
        }
      ],
      "isGlobal": false,
      "query": {
        "query": "{\"measures\":[[\"count\",\"*\"]],\"filters\":[[\"Risk_Band__c\",[\"Critical\"],\"in\"]]}",
        "version": -1
      },
      "receiveFacetSource": {
        "mode": "all",
        "steps": []
      },
