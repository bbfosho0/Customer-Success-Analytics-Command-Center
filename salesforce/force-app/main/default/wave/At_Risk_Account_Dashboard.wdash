    "risk_detail_queue": {
      "datasets": [
        {
          "name": "Churn_Risk_Accounts"
        }
      ],
      "isFacet": false,
      "isGlobal": false,
      "label": "portfolio_table",
      "query": {
        "query": "{\"measures\":[],\"values\":[\"Priority_Rank__c\",\"Account_Name__c\",\"Risk_Band__c\",\"MRR__c\",\"Health_Score__c\",\"Main_Risk_Driver__c\",\"Customer_Success_Manager__c\",\"Recommended_Action__c\"],\"groups\":[],\"filters\":[[\"Risk_Band__c\",[\"Critical\",\"At Risk\",\"Watch\"],\"in\"]],\"order\":[[\"Priority_Rank__c\",{\"ascending\":true}]],\"limit\":50}",
        "version": -1
      },
      "selectMode": "none",
      "type": "grain",
      "useExternalFilters": true,
      "useGlobal": true,
      "visualizationParameters": {
        "options": {},
