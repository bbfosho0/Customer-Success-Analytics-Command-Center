  "steps": {
    "risk_detail_filter_csm": {
      "broadcastFacet": true,
      "datasets": [
        {
          "name": "Churn_Risk_Accounts"
        }
      ],
      "isGlobal": false,
      "query": {
        "query": "{\"measures\":[[\"count\",\"*\"]],\"groups\":[\"Customer_Success_Manager__c\"],\"order\":[[\"Customer_Success_Manager__c\",{\"ascending\":true}]]}",
        "version": -1
      },
      "receiveFacetSource": {
        "mode": "all",
        "steps": []
      },
      "selectMode": "multi",
      "type": "aggregateflex",
      "useExternalFilters": true,
      "useGlobal": true,
      "visualizationParameters": {
        "options": {},
        "visualizationType": "hbar"
      }
    },
    "risk_detail_filter_segment": {
      "broadcastFacet": true,
      "datasets": [
        {
          "name": "Churn_Risk_Accounts"
        }
      ],
      "isGlobal": false,
      "query": {
        "query": "{\"measures\":[[\"count\",\"*\"]],\"groups\":[\"Segment__c\"],\"order\":[[\"Segment__c\",{\"ascending\":true}]]}",
        "version": -1
      },
      "receiveFacetSource": {
        "mode": "all",
        "steps": []
      },
      "selectMode": "multi",
