        }
      ],
      "isGlobal": false,
      "query": {
        "query": "{\"measures\":[[\"count\",\"*\"]],\"groups\":[\"Plan_Tier__c\"],\"order\":[[\"Plan_Tier__c\",{\"ascending\":true}]]}",
        "version": -1
      },
      "receiveFacetSource": {
        "mode": "all",
        "steps": []
      },
