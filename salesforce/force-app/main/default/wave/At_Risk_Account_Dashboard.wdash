        }
      ],
      "isGlobal": false,
      "query": {
        "query": "{\"measures\":[[\"count\",\"*\"]],\"groups\":[\"Region__c\"],\"order\":[[\"Region__c\",{\"ascending\":true}]]}",
        "version": -1
      },
      "receiveFacetSource": {
        "mode": "all",
        "steps": []
