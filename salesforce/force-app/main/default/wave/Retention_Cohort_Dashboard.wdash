    "ret_detail_table": {
      "datasets": [
        {
          "name": "Retention_Cohorts"
        }
      ],
      "isFacet": false,
      "isGlobal": false,
      "label": "portfolio_table",
      "query": {
        "query": "{\"measures\":[],\"values\":[\"Cohort_Quarter__c\",\"Month_Since_Acquisition__c\",\"Cohort_Size__c\",\"Retained_Customers__c\",\"Retention_Rate__c\"],\"groups\":[],\"filters\":[],\"order\":[[\"Cohort_Quarter__c\",{\"ascending\":true}],[\"Month_Since_Acquisition__c\",{\"ascending\":true}]],\"limit\":100}",
        "version": -1
      },
      "selectMode": "none",
      "type": "grain",
      "useExternalFilters": true,
      "useGlobal": true,
      "visualizationParameters": {
        "options": {},
        "visualizationType": "valuestable"
      }
    }
