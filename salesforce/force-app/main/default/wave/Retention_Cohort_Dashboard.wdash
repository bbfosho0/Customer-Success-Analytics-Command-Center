  "layouts": [],
  "steps": {
    "ret_detail_filter": {
      "broadcastFacet": true,
      "datasets": [
        {
          "name": "Retention_Cohorts"
        }
      ],
      "isGlobal": false,
      "query": {
        "query": "{\"measures\":[[\"count\",\"*\"]],\"groups\":[\"Cohort_Month__c\"],\"order\":[[\"Cohort_Month__c\",{\"ascending\":true}]]}",
        "version": -1
      },
      "receiveFacetSource": {
        "mode": "all",
        "steps": []
      },
      "selectMode": "multi",
      "type": "aggregateflex",
      "useExternalFilters": true,
      "useGlobal": true,
      "visualizationParameters": {
        "options": {},
        "visualizationType": "hbar"
      }
    },
    "ret_detail_rate": {
      "broadcastFacet": false,
      "datasets": [
        {
          "name": "Retention_Cohorts"
        }
      ],
      "isGlobal": false,
      "query": {
        "query": "{\"measures\":[[\"avg\",\"Retention_Rate__c\"]],\"filters\":[]}",
        "version": -1
      },
      "receiveFacetSource": {
        "mode": "all",
        "steps": []
      },
      "selectMode": "multi",
      "type": "aggregateflex",
      "useExternalFilters": true,
      "useGlobal": true,
      "visualizationParameters": {
        "options": {},
        "visualizationType": "hbar"
      }
    },
    "ret_detail_size": {
      "broadcastFacet": false,
      "datasets": [
        {
          "name": "Retention_Cohorts"
        }
      ],
      "isGlobal": false,
      "query": {
        "query": "{\"measures\":[[\"max\",\"Cohort_Size__c\"]],\"filters\":[]}",
        "version": -1
      },
      "receiveFacetSource": {
        "mode": "all",
        "steps": []
      },
      "selectMode": "multi",
      "type": "aggregateflex",
      "useExternalFilters": true,
      "useGlobal": true,
      "visualizationParameters": {
        "options": {},
        "visualizationType": "hbar"
      }
    },
    "ret_detail_ltv_avg": {
