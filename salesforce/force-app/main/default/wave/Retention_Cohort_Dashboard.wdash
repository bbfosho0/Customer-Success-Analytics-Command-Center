      "datasets": [
        {
          "name": "LTV_By_Segment"
        }
      ],
      "isGlobal": false,
      "query": {
        "query": "{\"measures\":[[\"avg\",\"Estimated_LTV__c\"]],\"filters\":[]}",
        "version": -1
      },
      "receiveFacetSource": {
        "mode": "all",
        "steps": []
      },
      "selectMode": "multi",
      "type": "aggregateflex",
      "useExternalFilters": true,
      "useGlobal": true,
      "visualizationParameters": {
        "options": {},
        "visualizationType": "hbar"
      }
    },
    "ret_detail_trend": {
      "broadcastFacet": false,
      "datasets": [
        {
          "name": "Retention_Cohorts"
        }
      ],
      "isGlobal": false,
      "query": {
        "query": "{\"measures\":[[\"avg\",\"Retention_Rate__c\"]],\"groups\":[\"Month_Since_Acquisition__c\"],\"order\":[[\"Month_Since_Acquisition__c\",{\"ascending\":true}]]}",
        "version": -1
      },
      "receiveFacetSource": {
        "mode": "all",
        "steps": []
      },
      "selectMode": "multi",
      "type": "aggregateflex",
      "useExternalFilters": true,
      "useGlobal": true,
      "visualizationParameters": {
        "options": {},
        "visualizationType": "line"
      }
    },
    "ret_detail_heatmap": {
      "broadcastFacet": false,
      "datasets": [
        {
          "name": "Retention_Cohorts"
        }
      ],
      "isGlobal": false,
      "query": {
        "query": "{\"measures\":[[\"avg\",\"Retention_Rate__c\"]],\"groups\":[\"Cohort_Quarter__c\",\"Month_Since_Acquisition__c\"],\"order\":[[\"Cohort_Quarter__c\",{\"ascending\":true}],[\"Month_Since_Acquisition__c\",{\"ascending\":true}]]}",
        "version": -1
      },
      "receiveFacetSource": {
        "mode": "all",
        "steps": []
      },
      "selectMode": "multi",
      "type": "aggregateflex",
      "useExternalFilters": true,
      "useGlobal": true,
      "visualizationParameters": {
        "options": {},
        "visualizationType": "matrix"
      }
    },
    "ret_detail_ltv": {
      "broadcastFacet": false,
      "datasets": [
        {
          "name": "LTV_By_Segment"
        }
      ],
      "isGlobal": false,
      "query": {
        "query": "{\"measures\":[[\"avg\",\"Estimated_LTV__c\"]],\"groups\":[\"Segment__c\"],\"order\":[[\"avg_Estimated_LTV__c\",{\"ascending\":false}]]}",
        "version": -1
      },
      "receiveFacetSource": {
        "mode": "all",
        "steps": []
